# Database (PostgreSQL – Supabase) – project: actfqdgdmwfypffqazdv
# Get password from: Supabase Dashboard → Settings → Database
#
# --- VERCEL / SERVERLESS: use POOLER (direct host is often unreachable) ---
# Replace YOUR_DB_PASSWORD and optionally user (postgres.PROJECT_REF or prisma.PROJECT_REF).
DATABASE_URL="postgresql://postgres.actfqdgdmwfypffqazdv:YOUR_DB_PASSWORD@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true&connect_timeout=30"
DIRECT_URL="postgresql://postgres.actfqdgdmwfypffqazdv:YOUR_DB_PASSWORD@aws-1-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require"
#
# --- LOCAL (if pooler fails locally): direct connection ---
# DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@db.actfqdgdmwfypffqazdv.supabase.co:5432/postgres?sslmode=require"
# DIRECT_URL="postgresql://postgres:YOUR_DB_PASSWORD@db.actfqdgdmwfypffqazdv.supabase.co:5432/postgres?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# App Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
VERCEL_TOOLBAR_ENABLED="false"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:ops@example.com"
PUSH_PROCESSOR_CRON_SECRET=""
PUSH_RESERVATION_STARTS_SOON_MINUTES="60"
PUSH_INSURANCE_EXPIRY_DAYS="7"

# Feature flags (security hardening)
# Keep disabled by default; enable progressively (staging -> pilot -> production)
FEATURE_AUTH_RATE_LIMIT="false"
FEATURE_AUTH_LOCKOUT="false"

# Auth protection tuning
AUTH_RATE_LIMIT_WINDOW_MS="600000"
AUTH_RATE_LIMIT_MAX_ATTEMPTS="5"
AUTH_LOCKOUT_MS="900000"

# Upload abuse protection (disabled by default)
FEATURE_UPLOAD_RATE_LIMIT="false"
UPLOAD_RATE_LIMIT_WINDOW_MS="60000"
UPLOAD_RATE_LIMIT_MAX_REQUESTS="20"
UPLOAD_MAX_BYTES_PER_WINDOW="52428800"

# Optional security audit DB sink (structured logs are always emitted to server logs)
FEATURE_AUDIT_DB_LOG="false"
