// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  OWNER
  MANAGER
  EMPLOYEE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VehicleStatus {
  AVAILABLE
  RENTED
  MAINTENANCE
  UNAVAILABLE
}

enum BookingStatus {
  DRAFT
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELED
}

enum PaymentType {
  CASH
  CARD
  TRANSFER
  CMI
  OTHER
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum PaymentCategory {
  RENTAL
  DEPOSIT
  REFUND
}

enum BookingPaymentStatus {
  PENDING
  PARTIAL
  PAID
}

enum BookingDepositStatus {
  PENDING
  RECEIVED
  RETURNED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

enum DepositStatus {
  HELD
  PARTIAL_RETURNED
  RETURNED
  FORFEITED
}

enum DepositAction {
  RELEASE
  PARTIAL
  HOLD
}

enum ExpenseCategory {
  MAINTENANCE
  CARBURANT
  NETTOYAGE
  ASSURANCE
  TAXES
  SALAIRES
  LOYER
  MARKETING
  AUTRE
}

enum InspectionSectionType {
  CARROSSERIE
  PNEUS
  INTERIEUR
  KILOMETRAGE
  CARBURANT
}

enum InspectionStatus {
  OK
  DAMAGE
}

enum InspectionType {
  DEPART
  RETOUR
}

enum InfractionType {
  SPEEDING
  PARKING
  RED_LIGHT
  TOLL
  OTHER
}

enum InfractionStatus {
  PENDING
  ASSIGNED
  PAID
  CONTESTED
}

enum ReminderType {
  OIL_CHANGE
  INSURANCE_EXPIRY
  TECH_INSPECTION
  VIGNETTE
}

enum NotificationSeverity {
  INFO
  WARNING
  DUE
}

enum NotificationStatus {
  OPEN
  SNOOZED
  DONE
  DISMISSED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  WHATSAPP
}

enum NotificationEventStatus {
  PENDING
  SENT
  FAILED
}

enum NotificationEventType {
  CREATED
  ESCALATED_DUE
}

enum VehicleDocumentType {
  INSURANCE
  TECHNICAL_INSPECTION
  VIGNETTE
  REGISTRATION
}

model Agency {
  id       String @id @default(cuid())
  name     String
  address  String?
  phone    String?
  email    String?
  city     String
  rcNumber String?
  logoUrl  String?
  country  String @default("Morocco")
  currency String @default("MAD")
  subscriptionPaid   Boolean   @default(false)
  subscriptionEndsAt DateTime?
  setupCompletedAt DateTime?

  onboardingVehicleAdded        Boolean @default(false)
  onboardingReservationCreated  Boolean @default(false)
  onboardingPaymentRecorded     Boolean @default(false)
  onboardingDashboardExplored   Boolean @default(false)
  onboardingCompleted           Boolean @default(false)
  onboardingDismissed           Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  vehicles         Vehicle[]
  customers        Customer[]
  bookings         Booking[]
  expenses         Expense[]
  reminderRules    ReminderRule[]
  notifications    Notification[]
  vehicleDocuments VehicleDocument[]
  infractions      Infraction[]

  @@map("agencies")
}

model User {
  id                 String         @id @default(cuid())
  email              String         @unique
  password           String
  name               String
  role               UserRole       @default(EMPLOYEE)
  isActive           Boolean        @default(true)
  invitedAt          DateTime?
  invitedById        String?
  lastLoginAt        DateTime?
  emailVerifiedAt    DateTime?
  approvalStatus     ApprovalStatus @default(APPROVED)
  permissionOverrides Json?
  agencyId           String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agency              Agency                  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  emailVerificationTokens EmailVerificationToken[]

  @@index([agencyId])
  @@index([agencyId, role])
  @@map("users")
}

model EmailVerificationToken {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model RateLimitBucket {
  id            String   @id @default(cuid())
  scope         String
  key           String
  count         Int      @default(0)
  windowStartAt DateTime
  lockedUntil   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([scope, key])
  @@index([scope, windowStartAt])
  @@index([lockedUntil])
  @@map("rate_limit_buckets")
}

enum Gearbox {
  MANUAL
  AUTO
}

enum FuelType {
  DIESEL
  ESSENCE
  HYBRID
  ELECTRIC
}

model Vehicle {
  id                String        @id @default(cuid())
  agencyId          String
  make              String
  brandKey          String        @default("other")
  model             String
  year              Int
  plate             String        @unique
  color             String
  status            VehicleStatus @default(AVAILABLE)
  pricePerDay       Float
  depositAmount     Float         @default(2000)
  gearbox           Gearbox       @default(MANUAL)
  fuelType          FuelType      @default(ESSENCE)
  seats             Int           @default(5)
  hasAC             Boolean       @default(true)
  category          String        @default("Citadine")
  photoUrl          String?
  mileage           Int?
  currentKm         Int?
  nextMaintenanceKm Int?

  // Maintenance — oil change
  lastOilChangeMileageKm Int?
  lastOilChangeDate      DateTime?
  oilChangeIntervalKm    Int?
  oilChangeIntervalMonths Int?
  nextOilChangeMileageKm Int?
  nextOilChangeDate      DateTime?

  // Insurance
  insuranceProvider     String?
  insurancePolicyNumber String?
  insuranceStartDate    DateTime?
  insuranceExpiryDate   DateTime?
  insuranceReminderDays Int[]

  // Visite technique
  lastTechnicalInspectionDate     DateTime?
  nextTechnicalInspectionDate     DateTime?
  technicalInspectionReminderDays Int[]

  // Vignette
  vignetteExpiryDate    DateTime?
  vignetteReminderDays  Int[]

  // General
  maintenanceNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agency        Agency         @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  bookings      Booking[]
  expenses      Expense[]
  notifications Notification[]
  documents     VehicleDocument[]
  infractions   Infraction[]

  @@index([agencyId])
  @@index([status])
  @@index([agencyId, status], map: "vehicles_agency_status_idx")
  @@map("vehicles")
}

enum CustomerType {
  PERSONNE_PHYSIQUE
  PERSONNE_MORALE
}

model Customer {
  id                  String       @id @default(cuid())
  agencyId            String
  customerType        CustomerType @default(PERSONNE_PHYSIQUE)
  name                String
  email               String?
  phone               String
  passportOrCIN       String?
  passportOrCINExpiry DateTime?
  passportPhotoUrl    String?
  address             String?
  dateOfBirth         DateTime?
  nationality         String       @default("Marocaine")
  licenseNumber       String?
  licenseExpiry       DateTime?
  licensePhotoUrl     String?
  // Personne morale
  ice                 String?
  rc                  String?
  representativeName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agency      Agency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  bookings    Booking[]
  infractions Infraction[]

  @@index([agencyId])
  @@map("customers")
}

model Booking {
  id               String                 @id @default(cuid())
  agencyId         String
  vehicleId        String
  customerId       String
  startDate        DateTime
  endDate          DateTime
  actualReturnDate DateTime?
  pricePerDay      Float
  totalPrice       Float
  depositAmount    Float
  status           BookingStatus          @default(CONFIRMED)
  paymentStatus    BookingPaymentStatus   @default(PENDING)
  depositStatus    BookingDepositStatus   @default(PENDING)
  notes            String?
  pickupLocation   String?
  returnLocation   String?
  hasFullInsurance Boolean                @default(false)
  pricingDays      Float                  @default(0)
  pricingHours     Int                    @default(0)
  addonsTotal      Float                  @default(0)
  discountType     DiscountType?
  discountValue    Float                  @default(0)
  discountAmount   Float                  @default(0)
  taxEnabled       Boolean                @default(false)
  taxRate          Float                  @default(20)
  totalHt          Float                  @default(0)
  totalTva         Float                  @default(0)
  totalTtc         Float                  @default(0)
  paidNow          Float                  @default(0)
  remainingAmount  Float                  @default(0)
  flowVersion      String?
  contractImageUrl String?
  contractSignedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agency   Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  vehicle  Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  payments      Payment[]
  deposit       Deposit?
  addons        BookingAddon[]
  damageReports DamageReport[]
  infractions   Infraction[]

  @@index([agencyId])
  @@index([vehicleId])
  @@index([customerId])
  @@index([startDate])
  @@index([endDate])
  @@index([status])
  @@index([paymentStatus])
  @@index([vehicleId, status])
  @@index([agencyId, status])
  @@index([agencyId, status, startDate, endDate], map: "bookings_agency_status_start_end_idx")
  @@index([agencyId, status, endDate], map: "bookings_agency_status_end_idx")
  @@map("bookings")
}

model BookingAddon {
  id          String  @id @default(cuid())
  bookingId   String
  label       String
  unitAmount  Float
  quantity    Int     @default(1)
  totalAmount Float
  isDefault   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("booking_addons")
}

model Payment {
  id        String          @id @default(cuid())
  bookingId String
  amount    Float
  type      PaymentType
  category  PaymentCategory @default(RENTAL)
  status    PaymentStatus   @default(PENDING)
  paidAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([status])
  @@index([category])
  @@index([status, category, paidAt], map: "payments_status_category_paid_at_idx")
  @@index([status, updatedAt], map: "payments_status_updated_at_idx")
  @@index([bookingId, status, category], map: "payments_booking_status_category_idx")
  @@map("payments")
}

model Deposit {
  id         String        @id @default(cuid())
  bookingId  String        @unique
  amount     Float
  status     DepositStatus @default(HELD)
  heldAt     DateTime      @default(now())
  returnedAt DateTime?
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([status, heldAt], map: "deposits_status_held_at_idx")
  @@index([status, returnedAt], map: "deposits_status_returned_at_idx")
  @@map("deposits")
}

model Expense {
  id         String          @id @default(cuid())
  agencyId   String
  date       DateTime
  category   ExpenseCategory
  amount     Decimal         @db.Decimal(12, 2)
  method     PaymentType
  vehicleId  String?
  note       String?
  receiptUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agency  Agency  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@index([agencyId, date])
  @@index([agencyId, category])
  @@index([agencyId, vehicleId])
  @@index([vehicleId])
  @@map("expenses")
}

model DamageReport {
  id                String         @id @default(cuid())
  bookingId         String
  inspectionType    InspectionType @default(RETOUR)
  fuelLevel         String?
  cleanliness       String?
  notes             String?
  depositAction     DepositAction
  totalDamageCost   Float          @default(0)
  deductFromDeposit Boolean        @default(false)
  deductedAmount    Float          @default(0)
  reportedAt        DateTime       @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking      Booking              @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  damagePhotos DamagePhoto[]
  sections     InspectionSection[]

  @@index([bookingId])
  @@map("damage_reports")
}

model DamagePhoto {
  id              String  @id @default(cuid())
  damageReportId  String
  sectionId       String?
  photoUrl        String
  description     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  damageReport DamageReport       @relation(fields: [damageReportId], references: [id], onDelete: Cascade)
  section      InspectionSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@index([damageReportId])
  @@index([sectionId])
  @@map("damage_photos")
}

model InspectionSection {
  id              String                @id @default(cuid())
  damageReportId  String
  sectionType     InspectionSectionType
  status          InspectionStatus      @default(OK)
  notes           String?
  damageCost      Float                 @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  damageReport DamageReport  @relation(fields: [damageReportId], references: [id], onDelete: Cascade)
  photos       DamagePhoto[]

  @@index([damageReportId])
  @@map("inspection_sections")
}

model ReminderRule {
  id              String       @id @default(cuid())
  agencyId        String
  type            ReminderType
  enabled         Boolean      @default(true)
  leadDays        Int[]
  leadKm          Int[]
  channelInApp    Boolean      @default(true)
  channelEmail    Boolean      @default(false)
  channelWhatsApp Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@unique([agencyId, type])
  @@index([agencyId])
  @@map("reminder_rules")
}

model Notification {
  id           String               @id @default(cuid())
  agencyId     String
  vehicleId    String
  type         ReminderType
  title        String
  body         String
  severity     NotificationSeverity
  dueAt        DateTime?
  dueMileageKm Int?
  status       NotificationStatus   @default(OPEN)
  snoozedUntil DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  agency  Agency              @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  vehicle Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  events  NotificationEvent[]

  @@unique([agencyId, vehicleId, type])
  @@index([agencyId])
  @@index([vehicleId])
  @@index([status])
  @@index([agencyId, status, severity, updatedAt], map: "notifications_agency_status_severity_updated_at_idx")
  @@map("notifications")
}

model NotificationEvent {
  id                String                  @id @default(cuid())
  notificationId    String
  channel           NotificationChannel
  eventType         NotificationEventType   @default(CREATED)
  status            NotificationEventStatus @default(PENDING)
  providerMessageId String?
  lastError         String?
  createdAt         DateTime                @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@index([notificationId, channel, eventType, status])
  @@map("notification_events")
}

model VehicleDocument {
  id        String              @id @default(cuid())
  agencyId  String
  vehicleId String
  type      VehicleDocumentType
  reference String?
  startDate DateTime?
  expiryDate DateTime?
  fileUrl   String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  agency  Agency  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([agencyId, vehicleId, type])
  @@index([agencyId])
  @@index([vehicleId])
  @@map("vehicle_documents")
}

model Infraction {
  id          String           @id @default(cuid())
  agencyId    String
  vehicleId   String
  bookingId   String?
  customerId  String?
  date        DateTime
  time        String?
  type        InfractionType   @default(OTHER)
  status      InfractionStatus @default(PENDING)
  amount      Float?
  notes       String?

  // Snapshot fields (frozen at assignment)
  clientName  String?
  clientCin   String?
  clientPhone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agency   Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  vehicle  Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  booking  Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([agencyId])
  @@index([agencyId, date])
  @@index([agencyId, status])
  @@index([agencyId, vehicleId, date])
  @@map("infractions")
}

model SecurityAuditLog {
  id          BigInt   @id @default(autoincrement())
  occurredAt  DateTime @default(now()) @map("occurred_at")
  agencyId    String   @map("agency_id")
  actorUserId String?  @map("actor_user_id")
  actorRole   String   @map("actor_role")
  actorEmail  String?  @map("actor_email")
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  outcome     String
  details     Json?
  requestId   String?  @map("request_id")
  ip          String?
  userAgent   String?  @map("user_agent")

  @@index([agencyId, occurredAt])
  @@index([action, occurredAt])
  @@index([entityType, entityId, occurredAt])
  @@map("security_audit_logs")
}
