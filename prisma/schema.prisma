// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  OWNER
  MANAGER
  EMPLOYEE
}

enum VehicleStatus {
  AVAILABLE
  RENTED
  MAINTENANCE
  UNAVAILABLE
}

enum BookingStatus {
  DRAFT
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELED
}

enum PaymentType {
  CASH
  CARD
  TRANSFER
  CMI
  OTHER
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum PaymentCategory {
  RENTAL
  DEPOSIT
  REFUND
}

enum BookingPaymentStatus {
  PENDING
  PARTIAL
  PAID
}

enum BookingDepositStatus {
  PENDING
  RECEIVED
  RETURNED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

enum DepositStatus {
  HELD
  PARTIAL_RETURNED
  RETURNED
  FORFEITED
}

enum DepositAction {
  RELEASE
  PARTIAL
  HOLD
}

enum ExpenseCategory {
  MAINTENANCE
  CARBURANT
  NETTOYAGE
  ASSURANCE
  TAXES
  SALAIRES
  LOYER
  MARKETING
  AUTRE
}

enum InspectionSectionType {
  CARROSSERIE
  PNEUS
  INTERIEUR
  KILOMETRAGE
  CARBURANT
}

enum InspectionStatus {
  OK
  DAMAGE
}

enum InspectionType {
  DEPART
  RETOUR
}

enum ReminderType {
  OIL_CHANGE
  INSURANCE_EXPIRY
  TECH_INSPECTION
  VIGNETTE
}

enum NotificationSeverity {
  INFO
  WARNING
  DUE
}

enum NotificationStatus {
  OPEN
  SNOOZED
  DONE
  DISMISSED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  WHATSAPP
}

enum NotificationEventStatus {
  PENDING
  SENT
  FAILED
}

model Agency {
  id       String @id @default(cuid())
  name     String
  address  String
  phone    String
  email    String
  city     String
  country  String @default("Morocco")
  currency String @default("MAD")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  vehicles         Vehicle[]
  customers        Customer[]
  bookings         Booking[]
  expenses         Expense[]
  reminderRules    ReminderRule[]
  notifications    Notification[]

  @@map("agencies")
}

model User {
  id       String   @id @default(cuid())
  email    String   @unique
  password String
  name     String
  role     UserRole @default(EMPLOYEE)
  isActive Boolean  @default(true)
  invitedAt DateTime?
  invitedById String?
  lastLoginAt DateTime?
  agencyId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId])
  @@index([agencyId, role])
  @@map("users")
}

enum Gearbox {
  MANUAL
  AUTO
}

model Vehicle {
  id                String        @id @default(cuid())
  agencyId          String
  make              String
  model             String
  year              Int
  plate             String        @unique
  color             String
  status            VehicleStatus @default(AVAILABLE)
  pricePerDay       Float
  depositAmount     Float         @default(2000)
  gearbox           Gearbox       @default(MANUAL)
  seats             Int           @default(5)
  hasAC             Boolean       @default(true)
  category          String        @default("Citadine")
  photoUrl          String?
  mileage           Int?
  currentKm         Int?
  nextMaintenanceKm Int?

  // Maintenance — oil change
  lastOilChangeMileageKm Int?
  lastOilChangeDate      DateTime?
  oilChangeIntervalKm    Int?
  oilChangeIntervalMonths Int?
  nextOilChangeMileageKm Int?
  nextOilChangeDate      DateTime?

  // Insurance
  insuranceProvider     String?
  insurancePolicyNumber String?
  insuranceStartDate    DateTime?
  insuranceExpiryDate   DateTime?
  insuranceReminderDays Int[]

  // Visite technique
  lastTechnicalInspectionDate     DateTime?
  nextTechnicalInspectionDate     DateTime?
  technicalInspectionReminderDays Int[]

  // Vignette
  vignetteExpiryDate    DateTime?
  vignetteReminderDays  Int[]

  // General
  maintenanceNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agency        Agency         @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  bookings      Booking[]
  expenses      Expense[]
  notifications Notification[]

  @@index([agencyId])
  @@index([status])
  @@map("vehicles")
}

enum CustomerType {
  PERSONNE_PHYSIQUE
  PERSONNE_MORALE
}

model Customer {
  id                  String       @id @default(cuid())
  agencyId            String
  customerType        CustomerType @default(PERSONNE_PHYSIQUE)
  name                String
  email               String?
  phone               String
  passportOrCIN       String?
  passportOrCINExpiry DateTime?
  passportPhotoUrl    String?
  address             String?
  dateOfBirth         DateTime?
  nationality         String       @default("Marocaine")
  licenseNumber       String?
  licenseExpiry       DateTime?
  licensePhotoUrl     String?
  // Personne morale
  ice                 String?
  rc                  String?
  representativeName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agency   Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([agencyId])
  @@map("customers")
}

model Booking {
  id               String                 @id @default(cuid())
  agencyId         String
  vehicleId        String
  customerId       String
  startDate        DateTime
  endDate          DateTime
  actualReturnDate DateTime?
  pricePerDay      Float
  totalPrice       Float
  depositAmount    Float
  status           BookingStatus          @default(CONFIRMED)
  paymentStatus    BookingPaymentStatus   @default(PENDING)
  depositStatus    BookingDepositStatus   @default(PENDING)
  notes            String?
  pickupLocation   String?
  returnLocation   String?
  hasFullInsurance Boolean                @default(false)
  pricingDays      Float                  @default(0)
  pricingHours     Int                    @default(0)
  addonsTotal      Float                  @default(0)
  discountType     DiscountType?
  discountValue    Float                  @default(0)
  discountAmount   Float                  @default(0)
  taxEnabled       Boolean                @default(false)
  taxRate          Float                  @default(20)
  totalHt          Float                  @default(0)
  totalTva         Float                  @default(0)
  totalTtc         Float                  @default(0)
  paidNow          Float                  @default(0)
  remainingAmount  Float                  @default(0)
  flowVersion      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agency   Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  vehicle  Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  payments      Payment[]
  deposit       Deposit?
  addons        BookingAddon[]
  damageReports DamageReport[]

  @@index([agencyId])
  @@index([vehicleId])
  @@index([customerId])
  @@index([startDate])
  @@index([endDate])
  @@index([status])
  @@index([paymentStatus])
  @@index([vehicleId, status])
  @@index([agencyId, status])
  @@map("bookings")
}

model BookingAddon {
  id          String  @id @default(cuid())
  bookingId   String
  label       String
  unitAmount  Float
  quantity    Int     @default(1)
  totalAmount Float
  isDefault   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("booking_addons")
}

model Payment {
  id        String          @id @default(cuid())
  bookingId String
  amount    Float
  type      PaymentType
  category  PaymentCategory @default(RENTAL)
  status    PaymentStatus   @default(PENDING)
  paidAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([status])
  @@index([category])
  @@map("payments")
}

model Deposit {
  id         String        @id @default(cuid())
  bookingId  String        @unique
  amount     Float
  status     DepositStatus @default(HELD)
  heldAt     DateTime      @default(now())
  returnedAt DateTime?
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("deposits")
}

model Expense {
  id         String          @id @default(cuid())
  agencyId   String
  date       DateTime
  category   ExpenseCategory
  amount     Decimal         @db.Decimal(12, 2)
  method     PaymentType
  vehicleId  String?
  note       String?
  receiptUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agency  Agency  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@index([agencyId, date])
  @@index([agencyId, category])
  @@index([agencyId, vehicleId])
  @@map("expenses")
}

model DamageReport {
  id                String         @id @default(cuid())
  bookingId         String
  inspectionType    InspectionType @default(RETOUR)
  fuelLevel         String?
  cleanliness       String?
  notes             String?
  depositAction     DepositAction
  totalDamageCost   Float          @default(0)
  deductFromDeposit Boolean        @default(false)
  deductedAmount    Float          @default(0)
  reportedAt        DateTime       @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking      Booking              @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  damagePhotos DamagePhoto[]
  sections     InspectionSection[]

  @@index([bookingId])
  @@map("damage_reports")
}

model DamagePhoto {
  id              String  @id @default(cuid())
  damageReportId  String
  sectionId       String?
  photoUrl        String
  description     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  damageReport DamageReport       @relation(fields: [damageReportId], references: [id], onDelete: Cascade)
  section      InspectionSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@index([damageReportId])
  @@index([sectionId])
  @@map("damage_photos")
}

model InspectionSection {
  id              String                @id @default(cuid())
  damageReportId  String
  sectionType     InspectionSectionType
  status          InspectionStatus      @default(OK)
  notes           String?
  damageCost      Float                 @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  damageReport DamageReport  @relation(fields: [damageReportId], references: [id], onDelete: Cascade)
  photos       DamagePhoto[]

  @@index([damageReportId])
  @@map("inspection_sections")
}

model ReminderRule {
  id              String       @id @default(cuid())
  agencyId        String
  type            ReminderType
  enabled         Boolean      @default(true)
  leadDays        Int[]
  leadKm          Int[]
  channelInApp    Boolean      @default(true)
  channelEmail    Boolean      @default(false)
  channelWhatsApp Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@unique([agencyId, type])
  @@index([agencyId])
  @@map("reminder_rules")
}

model Notification {
  id           String               @id @default(cuid())
  agencyId     String
  vehicleId    String
  type         ReminderType
  title        String
  body         String
  severity     NotificationSeverity
  dueAt        DateTime?
  dueMileageKm Int?
  status       NotificationStatus   @default(OPEN)
  snoozedUntil DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  agency  Agency              @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  vehicle Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  events  NotificationEvent[]

  @@unique([agencyId, vehicleId, type])
  @@index([agencyId])
  @@index([vehicleId])
  @@index([status])
  @@map("notifications")
}

model NotificationEvent {
  id                String                  @id @default(cuid())
  notificationId    String
  channel           NotificationChannel
  status            NotificationEventStatus @default(PENDING)
  providerMessageId String?
  lastError         String?
  createdAt         DateTime                @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@map("notification_events")
}
